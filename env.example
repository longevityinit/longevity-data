# For cloud uploads, copy this file to .env in the repository root and fill in storage settings.
# Optional for --local builds. Without --local, scripts upload their outputs.
# Keep real credentials in .env (gitignored), never in this example file.

# Backblaze B2 bucket and its S3-compatible endpoint URL.
B2_BUCKET_NAME=
B2_ENDPOINT_URL=

# Application key credentials with access to the configured bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
